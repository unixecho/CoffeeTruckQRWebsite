# Supabase — from the project's API settings page.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key. Server-only: every catalogue write goes through an API
# route that checks the caller is an owner first. Never expose to the client,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# The site's own origin, used to build the OAuth redirect. Vercel sets
# VERCEL_URL automatically for preview deploys; set this for production.
NEXT_PUBLIC_SITE_URL=https://coffee-truck-shop.vercel.app

# The first owner. On first Google sign-in this address is granted owner
# access automatically (see supabase/migrations/003_owners.sql). Everyone
# else has to be invited from the manager.
OWNER_BOOTSTRAP_EMAIL=nikolsburgj@gmail.com

# ---------------------------------------------------------------------------
# Payments
#
# Nothing below is needed until the Grow merchant account exists. With
# PAYMENT_PROVIDER unset the checkout offers "pay at the counter" only, which
# is what the business does today — not a degraded mode.
#
# See docs/PAYMENTS.md §2 for what to fill in and what to verify against
# Grow's own documentation when the credentials arrive.
# ---------------------------------------------------------------------------

# manual (the counter) or grow. Anything unrecognised falls back to manual: a
# typo in a dashboard should degrade the checkout, not select a processor.
PAYMENT_PROVIDER=manual

# The API root Grow issues — the sandbox host during integration, the live one
# after. Must be https; a payment API over plain http is refused outright.
# GROW_API_BASE=https://sandbox.example.grow

# The origin the hosted payment PAGE is served from, which can differ from the
# API host. It becomes the CSP `frame-src` and the allowlist checked before any
# URL reaches an <iframe src>, so getting it wrong is a blank frame at a
# counter in one direction and a hole in the other.
# GROW_CHECKOUT_ORIGIN=https://secure.example.grow

# GROW_PAGE_CODE=
# GROW_USER_ID=
# GROW_API_KEY=

# Only if Grow issues a callback signing secret. Its absence is handled: an
# unsigned callback is treated as untrusted until a server-to-server read of
# the transaction agrees, so setting this can only tighten things.
# GROW_WEBHOOK_SECRET=

# How long an unpaid order is held. Default 20 — the queue at a stand plus a
# margin, and short enough that the price quoted is still the price stored.
# CHECKOUT_EXPIRY_MINUTES=20

# How long to wait on the provider before answering the customer. Default 12s.
# PAYMENT_PROVIDER_TIMEOUT_MS=12000
